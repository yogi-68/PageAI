# PageCortex production environment variables
# Copy to Vercel → Project → Settings → Environment Variables

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=PageCortex

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=

# OpenAI
OPENAI_API_KEY=

# Admin
ADMIN_EMAILS=you@example.com

# API integrations (encrypt credentials at rest)
ENCRYPTION_SECRET=

# Dodo Payments — production (DODO_TEST_MODE=false, DODO_MOCK_PAYMENTS=false)
DODO_MOCK_PAYMENTS=false
DODO_TEST_MODE=false
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=

# Plan product IDs (live Dodo dashboard)
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_SCALE=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_GROWTH_YEARLY=
DODO_PRODUCT_SCALE_YEARLY=

# Message pack product IDs — use one-time Dodo PRODUCTS (prod_*), not subscription add-ons (adn_*)
DODO_ADDON_1000=
DODO_ADDON_5000=
DODO_ADDON_10000=

# REMOVE from production — sandbox only
# DODO_TEST_PAYMENTS_API_KEY=
# DODO_TEST_PRODUCT_ID=
